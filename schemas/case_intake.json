{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SarCaseIntake",
  "description": "Phase 1 intake form — aligned with sar_platform_core README (recovery)",
  "type": "object",
  "required": ["mission_id", "domain", "objective", "priority", "subject"],
  "properties": {
    "mission_id": { "type": "string" },
    "domain": { "enum": ["water", "land"] },
    "objective": {
      "enum": [
        "wreck_hunt",
        "vessel_sar",
        "aircraft_sar",
        "vehicle_sar",
        "person_search"
      ]
    },
    "play_id": {
      "description": "Template id e.g. water_vessel_sar from unified_pipeline_profiles.json",
      "type": "string"
    },
    "priority": { "enum": ["low", "medium", "high", "critical"] },
    "lkp": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "description": { "type": "string" },
        "time": { "type": "string", "format": "date-time" }
      }
    },
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "subject": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "integer" },
        "clothing_description": { "type": "string" },
        "medical_conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "relationship": { "type": "string" }
        }
      }
    }
  }
}
