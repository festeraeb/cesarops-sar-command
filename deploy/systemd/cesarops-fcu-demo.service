[Unit]
Description=CESARops Field Command Unit - public demo (in-memory, made-up incidents, no disk writes, no outbound)
After=network.target
[Service]
User=cesarops
ExecStart=/data/fcu/bin/fcu-server /data/fcu/demo/config.json
Restart=always
RestartSec=3
MemoryMax=400M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
InaccessiblePaths=/data/fcu/tester
IPAddressDeny=any
IPAddressAllow=localhost
[Install]
WantedBy=multi-user.target
